// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Journal {
  id          String   @id @default(cuid())
  title       String
  description String?
  userId      String
  trash       Boolean  @default(false)
  notes       Note[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, trash, updatedAt])
}

model Note {
  id        String   @id @default(cuid())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  title     String?
  content   Json?
  /// Content flattened to text, maintained on every write by lib/plate.ts.
  /// Exists so full-text search and word counts can work on plain text rather
  /// than walking the Plate JSON — simpler and much faster to index.
  plainText String?
  tags      Tag[]
  share     NoteShare?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Generated tsvector over title (weight A) and plainText (weight B), with a
  /// GIN index. Prisma cannot express `GENERATED ALWAYS AS ... STORED`, so the
  /// column is created by a hand-written migration and declared Unsupported here
  /// purely so Prisma knows it exists. It is never read or written through the
  /// Prisma API — searchRouter queries it with $queryRaw.
  searchVector Unsupported("tsvector")?

  @@index([journalId, createdAt])
}

/// A note published to anyone holding the link — the one row in this schema that
/// is deliberately readable without a session.
///
/// `noteId` is unique, so a note has at most one live link. That is what makes
/// "revoke" unambiguous: there is never a second token still in circulation that
/// the owner has forgotten about, and re-sharing an already-shared note hands
/// back the same URL rather than quietly minting a parallel one.
///
/// Nothing here says who may read it — possession of the token *is* the
/// authorization, which is why `token` is 32 bytes of CSPRNG output rather than a
/// cuid. The link is only as private as the channel it is pasted into.
///
/// Cascades from Note, so deleting a note takes its link with it. Trashing the
/// *journal* does not delete the row — it does not have to, because every read
/// re-checks `journal.trash`, so a trashed journal's links go dark and come back
/// if it is restored.
model NoteShare {
  id        String   @id @default(cuid())
  token     String   @unique
  noteId    String   @unique
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Tags belong to a user, not to a journal, so the same tag can span journals.
/// Every query must be scoped by userId — the unique constraint is on
/// ([userId, name]), so two users can independently own a tag called "work".
model Tag {
  id        String   @id @default(cuid())
  name      String
  userId    String
  notes     Note[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId, name])
}
