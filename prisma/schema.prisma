// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Journal {
  id          String   @id @default(cuid())
  title       String
  description String?
  userId      String
  trash       Boolean  @default(false)
  notes       Note[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, trash, updatedAt])
}

model Note {
  id        String   @id @default(cuid())
  journalId String
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  title     String?
  content   Json?
  /// Content flattened to text, maintained on every write by lib/plate.ts.
  /// Exists so full-text search and word counts can work on plain text rather
  /// than walking the Plate JSON — simpler and much faster to index.
  plainText String?
  tags      Tag[]
  /// Themes extracted by the AI pass. Empty until analysis runs, and the feature
  /// is env-gated, so every reader must treat these as optional.
  aiThemes  String[] @default([])
  /// One-word mood label from the same pass. Null when not yet analysed.
  aiMood    String?
  /// When the AI analysis last ran, so re-analysis can be skipped for unchanged
  /// notes rather than re-billed.
  aiAnalyzedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Generated tsvector over title (weight A) and plainText (weight B), with a
  /// GIN index. Prisma cannot express `GENERATED ALWAYS AS ... STORED`, so the
  /// column is created by a hand-written migration and declared Unsupported here
  /// purely so Prisma knows it exists. It is never read or written through the
  /// Prisma API — searchRouter queries it with $queryRaw.
  searchVector Unsupported("tsvector")?

  @@index([journalId, createdAt])
}

/// Tags belong to a user, not to a journal, so the same tag can span journals.
/// Every query must be scoped by userId — the unique constraint is on
/// ([userId, name]), so two users can independently own a tag called "work".
/// Per-user, per-day AI request counter.
///
/// A Postgres row rather than Redis: the limit only needs to be roughly right,
/// the app already has a database, and adding a second datastore for one integer
/// is not a trade worth making. The unique constraint on ([userId, day]) makes
/// the upsert atomic, so concurrent requests cannot both read the same count.
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  /// Calendar day in UTC, `yyyy-MM-dd`. UTC deliberately: the quota is a billing
  /// control, not a user-facing calendar, so it should not shift with timezone.
  day       String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  userId    String
  notes     Note[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId, name])
}
