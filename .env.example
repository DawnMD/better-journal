# ---------------------------------------------------------------------------
# Better Journal — environment template
#
# Copy to `.env.local` (Next.js reads it and it is gitignored) and fill in.
# Every variable declared in `env.ts` appears here; the app fails fast at boot
# if a required one is missing, so an empty value is better than a wrong one.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Pooled connection string used by the app at runtime.
# Local Postgres:  postgresql://postgres:postgres@localhost:5432/better-journal
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/better-journal"

# Direct (non-pooled) connection, used for migrations. Only needed on Neon/
# Vercel, where the pooled URL cannot run DDL. Locally, leave unset.
# DATABASE_URL_UNPOOLED=""

# Separate database for the Vitest suite. The router tests TRUNCATE between
# cases, so this must not point at a database you care about.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/better-journal-test"

# --- Clerk auth (required) -------------------------------------------------
# From the Clerk dashboard: https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Where Clerk's components live and where to land after auth. These are the
# values the app is built around; change them only if you move the routes.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# --- AI insights (optional) ------------------------------------------------
# The app builds and runs fine with all three unset — the AI panels simply do
# not render, and the procedures behind them return NOT_IMPLEMENTED.
#
# Both the flag AND the key are required server-side; the NEXT_PUBLIC_ mirror
# only hides the UI without a roundtrip and is not a security boundary.
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_INSIGHTS_ENABLED="false"
# NEXT_PUBLIC_AI_INSIGHTS_ENABLED="false"

# --- Development toggles ---------------------------------------------------
# Injects a random 200–1700ms delay into every oRPC call, for eyeballing
# loading states. Off unless explicitly set to 1.
# SLOW_RPC="0"

# Skips env validation entirely. Needed for `next build` in CI, where the real
# secrets are not present. Never set this in a running environment.
# SKIP_ENV_VALIDATION="1"

# --- Playwright E2E (optional) --------------------------------------------
# A Clerk test user, used by @clerk/testing to sign in headlessly.
# E2E_CLERK_USER_EMAIL=""
# E2E_CLERK_USER_PASSWORD=""
